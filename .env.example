# Copy to .env (never committed). No private keys here: deploys sign from an encrypted
# Foundry keystore (`cast wallet import <name> --interactive`).

# Monad testnet RPC. Public QuickNode endpoint, 50 rps:
# https://docs.monad.xyz/developer-essentials/testnet.md
MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# Optional deploy parameters (addresses only). Each defaults to the deployer.
ATTESTER=
RENDER_AGENT=
TREASURY=
FEE_BPS=1000
