# Copy to indexer/.env (never committed).
# HyperSync API token (https://envio.dev/app/api-tokens). With it the indexer syncs through HyperSync
# (monad-testnet), with the RPC as fallback; without it, it syncs from the RPC alone.
ENVIO_API_TOKEN=
# Optional overrides
# ENVIO_RPC_URL=https://testnet-rpc.monad.xyz
# ENVIO_START_BLOCK=69802475
